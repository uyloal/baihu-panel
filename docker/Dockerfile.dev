FROM golang:1.26-alpine AS go-env

FROM node:24-alpine

ENV TZ=Asia/Shanghai
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# Copy Go compiler and tools from official golang alpine image
COPY --from=go-env /usr/local/go /usr/local/go
ENV GOPATH=/go
ENV PNPM_HOME=/root/.pnpm
ENV PATH="/usr/local/go/bin:/go/bin:/app/data/node_modules/.bin:$PNPM_HOME/bin:$PNPM_HOME:/usr/local/bin:$PATH"

RUN apk add --no-cache \
    bash \
    git \
    curl \
    wget \
    vim \
    htop \
    ca-certificates \
    tzdata \
    rsync \
    openssh-client \
    make \
    gcc \
    musl-dev \
    && echo "${TZ}" > /etc/timezone \
    && ln -sf /usr/share/zoneinfo/${TZ} /etc/localtime \
    && corepack enable \
    && corepack prepare pnpm@11.24.0 --activate \
    && pnpm config set global-bin-dir /root/.pnpm/bin \
    && npm install -g concurrently

RUN go env -w GOPROXY=https://goproxy.cn,direct

COPY docker/docker-entrypoint-dev.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint-dev.sh

WORKDIR /app

EXPOSE 8052 5173

ENTRYPOINT ["docker-entrypoint-dev.sh"]
CMD ["make", "dev"]
